# NAPlatform — production environment template (Phase 12).
#
# Copy to `.env.production` (git-ignored) and fill in real values. This file
# documents EVERY setting production reads; it contains NO real secrets — the
# placeholders below are obvious dummies and MUST be replaced.
#
# Validate a filled-in file before releasing:
#   PRODUCTION_MODE=true make release-check
# or hit the admin endpoint on a running API:
#   GET /admin/release/readiness   (admin-only, redacted)
#
# The default (dev) stack needs NONE of these — it runs memory/dry-run with
# SQLite + in-memory sessions. These matter only for a real deployment.

# =========================================================================
# Deployment mode
# =========================================================================
# Turns on strict production readiness validation and HSTS. Leave unset/false
# for local dev (permissive defaults).
PRODUCTION_MODE=true

# =========================================================================
# Secrets (REQUIRED — no shipped defaults may survive to production)
# =========================================================================
# The seeded admin password. MUST NOT be the shipped default "ChangeMe123!".
ADMIN_PASSWORD=__set_a_strong_unique_password__

# =========================================================================
# Datastores
# =========================================================================
# Durable Postgres (NOT the SQLite scaffold). Required in production.
DATABASE_URL=postgresql+psycopg://nap:__db_password__@postgres:5432/naplatform
# Redis-backed sessions. Set REDIS_URL, or set SESSION_STORE_STRICT=true to make
# the API refuse to boot without its session backend (readiness needs one or the
# other in production).
REDIS_URL=redis://redis:6379/0
SESSION_STORE_STRICT=true
# Session token TTL (seconds).
SESSION_TTL_SECONDS=3600

# =========================================================================
# CORS / trusted origins
# =========================================================================
# Comma-separated browser origins allowed to call the API with credentials.
# Dev defaults to http://localhost:3000,http://localhost:8080 when unset.
# Production MUST set concrete origins — a wildcard "*" fails readiness.
TRUSTED_ORIGINS=https://naplatform.example.com

# =========================================================================
# Backend selection (default memory/dry-run; set these ONLY to go live)
# =========================================================================
# VECTOR_BACKEND=qdrant requires QDRANT_URL (and optionally QDRANT_API_KEY).
VECTOR_BACKEND=memory
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=__qdrant_api_key__
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
# GRAPH_BACKEND=neo4j requires NEO4J_URI + NEO4J_USER + NEO4J_PASSWORD.
GRAPH_BACKEND=memory
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__neo4j_password__
# HDFS workspace provisioning. Dry-run unless enabled.
HDFS_PROVISIONING_ENABLED=false
HDFS_NAMENODE=hdfs://hdfs-namenode:9000
HDFS_BIN=hdfs

# =========================================================================
# Agent routing (default OFF/dry-run; SSRF-safe per-department URLs only)
# =========================================================================
# AGENT_ROUTING_ENABLED=true requires at least one HERMES_{DEP}_URL configured.
AGENT_ROUTING_ENABLED=false
HERMES_ER_URL=http://hermes-er:8080
HERMES_IT_URL=http://hermes-it:8080
HERMES_EHS_URL=http://hermes-ehs:8080
HERMES_QC_URL=http://hermes-qc:8080
AGENT_REQUEST_TIMEOUT_SECONDS=30

# =========================================================================
# Branding (optional; safe non-secret defaults exist)
# =========================================================================
BRAND_NAME=HMGMA
NAPLATFORM_API_BASE_URL=http://api:8080
CORE_WEBUI_URL=http://localhost:3000

# =========================================================================
# Audit retention (advisory — non-destructive by default)
# =========================================================================
# Documented retention window. Nothing deletes audit rows unless an operator
# opts in by BOTH setting AUDIT_RETENTION_ENFORCE=true AND wiring an external
# retention job; this scaffold never performs a destructive deletion.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_ENFORCE=false
