# NAPlatform shared Docker Model Runner config (Phase 15).
#
# This is a NON-SECRET, editable env file consumed by docker-compose.model-runner.yml
# via `env_file:`. It is the single source of truth for the shared model + endpoint
# that the API and ALL hermes-* agents (ER / IT / EHS / QC) use — one model, no
# per-agent drift. Edit it in-repo; NO passwords / tokens / API keys belong here
# (an OpenAI-compatible OPENAI_API_KEY, if ever needed, is referenced by env name at
# run time and never committed).
#
# Two supported modes — pick ONE by setting DOCKER_MODEL_RUNNER_BASE_URL:
#
#   1) EXTERNAL endpoint (default below). Point at any reachable OpenAI-compatible
#      endpoint that serves gemma4:31b. The compose override adds
#      `extra_hosts: host.docker.internal:host-gateway`, so from inside the
#      containers the Docker host is reachable as host.docker.internal. Docker
#      Desktop exposes the Model Runner on host TCP port 12434 when enabled, hence
#      the default below. For a truly external box use its URL, e.g.
#          DOCKER_MODEL_RUNNER_BASE_URL=http://my-inference-host:8000/engines/v1
#
#   2) Docker Desktop LOCAL Model Runner via the internal DNS name (only resolvable
#      inside the Compose network when Model Runner is enabled). Set:
#          DOCKER_MODEL_RUNNER_BASE_URL=http://model-runner.docker.internal/engines/v1
#
# To NOT use a model runner at all, simply DON'T pass docker-compose.model-runner.yml
# (the default stack stays dry-run / model-less and safe).
DOCKER_MODEL_RUNNER_BASE_URL=http://host.docker.internal:12434/engines/v1
DOCKER_MODEL_RUNNER_MODEL=gemma4:31b
