# NAPlatform shared Docker Model Runner config.
#
# This is a NON-SECRET, editable env file consumed by docker-compose.model-runner.yml
# via `env_file:`. It is the single source of truth for the shared Docker Model
# Runner endpoint/model candidates used by the API, WebUI chat, and all hermes-*
# department agents.
#
# Selection rule:
#   - DOCKER_MODEL_RUNNER_DEFAULT_INDEX chooses one numbered candidate.
#   - Candidates are tried/configured by index order convention: 0, 1, 2, ...
#   - Runtime env vars DOCKER_MODEL_RUNNER_BASE_URL and DOCKER_MODEL_RUNNER_MODEL
#     may still override the selected list entry for one-off tests.
#   - No passwords/tokens/API keys belong in this file.
#
# Candidate 0: current workstation Docker Desktop Model Runner from containers.
DOCKER_MODEL_RUNNER_DEFAULT_INDEX=0
DOCKER_MODEL_RUNNER_0_NAME=local-docker-desktop
DOCKER_MODEL_RUNNER_0_BASE_URL=http://host.docker.internal:12434/engines/v1
DOCKER_MODEL_RUNNER_0_MODEL=gemma4:31b
DOCKER_MODEL_RUNNER_0_WEBUI_MODEL=docker.io/ai/gemma4:31B

# Candidate 1: GPU/workstation Model Runner on the lab network.
DOCKER_MODEL_RUNNER_1_NAME=workstation-192-168-100-10
DOCKER_MODEL_RUNNER_1_BASE_URL=http://192.168.100.10:12434/engines/v1
DOCKER_MODEL_RUNNER_1_MODEL=gemma4:31b
DOCKER_MODEL_RUNNER_1_WEBUI_MODEL=docker.io/ai/gemma4:31B

# Optional additional candidates can be appended without changing compose/code:
# DOCKER_MODEL_RUNNER_2_NAME=another-runner
# DOCKER_MODEL_RUNNER_2_BASE_URL=http://another-host:12434/engines/v1
# DOCKER_MODEL_RUNNER_2_MODEL=gemma4:31b
# DOCKER_MODEL_RUNNER_2_WEBUI_MODEL=docker.io/ai/gemma4:31B
